{
  "name": "intake",
  "version": "1.0.0",
  "private": true,
  "description": "A fluid and symptom log that keeps its data on your device.",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --format=iife --target=es2019 --loader:.jsx=jsx --define:process.env.NODE_ENV=\"\\\"production\\\"\" --outfile=app.js",
    "dev": "esbuild src/main.jsx --bundle --format=iife --target=es2019 --loader:.jsx=jsx --define:process.env.NODE_ENV=\"\\\"development\\\"\" --outfile=app.js --servedir=. --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  }
}
